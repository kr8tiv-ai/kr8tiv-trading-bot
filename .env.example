# Copy to `.env.local` and adjust for your dev environment.
# ALL secrets are in Windows Credential Manager — do NOT put keys here.
# This file is committed; `.env.local` is gitignored. If a key ever lands here,
# gitleaks will reject the commit (.gitleaks.toml catches mx0*, Telegram tokens,
# ETH/Solana private keys).

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# MEXC base URLs — currently production defaults. Override when MEXC migrates
# (historical precedent: Jan 12, 2026 futures domain migration). Config-driven
# so migration = one env line, not a rebuild.
MEXC_SPOT_BASE_URL=https://api.mexc.com
MEXC_FUTURES_BASE_URL=https://contract.mexc.com

# MEXC request window (milliseconds). Max 5000 per MEXC docs.
# Do NOT raise above 60000 — MEXC rejects with 700005.
MEXC_RECV_WINDOW_MS=5000

# Redis (local Memurai on 6379 by default). Matt's primary is Memurai Developer
# installed via `winget install MemuraiDeveloper` — runs as a Windows Service.
REDIS_URL=redis://127.0.0.1:6379

# SQLite — append-only ledger. WAL mode enforced at connection time
# (journal_mode=WAL, synchronous=FULL, foreign_keys=ON).
SQLITE_PATH=./data/core.sqlite
