{
  "name": "kr8tiv-mexc-bot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=core",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "smoke": "turbo smoke --filter=core",
    "setup:credentials": "tsx scripts/setup-credentials.ts",
    "verify-env": "tsx scripts/verify-env.ts",
    "preflight": "powershell -ExecutionPolicy Bypass -File scripts/preflight-windows.ps1",
    "panic": "tsx scripts/panic.ts",
    "arm": "tsx scripts/arm.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "place-order": "tsx apps/core/src/place-order.ts",
    "signals:scan": "tsx scripts/scan-signals.ts",
    "signals:watch": "tsx scripts/watch-signals.ts",
    "history:ingest": "tsx scripts/history-ingest.ts",
    "style:fingerprint": "tsx scripts/style-fingerprint.ts",
    "trade:review": "tsx scripts/trade-review.ts",
    "trade:journal": "tsx scripts/trade-review.ts --save",
    "lefthook:install": "pnpm exec lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^2.1",
    "lefthook": "^1.8",
    "tsup": "^8.3",
    "tsx": "^4.19",
    "turbo": "^2.1",
    "typescript": "^5.7",
    "vitest": "^2.1"
  }
}
