{
  "name": "core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/dev.ts",
    "build": "tsup src/dev.ts src/smoke.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@kr8tiv/config": "workspace:*",
    "@kr8tiv/db": "workspace:*",
    "@kr8tiv/executor": "workspace:*",
    "@kr8tiv/logger": "workspace:*",
    "@kr8tiv/mexc-futures": "workspace:*",
    "@kr8tiv/mexc-spot": "workspace:*",
    "@kr8tiv/redis-client": "workspace:*",
    "@kr8tiv/secrets": "workspace:*",
    "@kr8tiv/shared-types": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "pino": "^9.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6",
    "tsup": "^8.3",
    "tsx": "^4.19",
    "typescript": "^5.7",
    "vitest": "^2.1"
  }
}
