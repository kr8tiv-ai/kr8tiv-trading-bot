# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.env.local
/secrets/
.secrets/
*.key
*.pem
*.secret
*.token
.dev.vars
credentials.json
keys.json
**/secrets.*

# Allow the @kr8tiv/secrets source package (contains NO secrets; it's the
# SecretProvider abstraction over Windows Credential Manager).
!packages/secrets/
!packages/secrets/**

# GitHub Personal Access Tokens (belt & braces — pre-commit hook + patterns)
# Tokens live in Windows Credential Manager (target: kr8tiv-mexc-bot/github-pat), never in files.
# These globs catch accidental token dumps to disk from `gh auth` / scripts.
.github-token
github_pat_*
.gh_token
*.pat.txt

# MEXC creds (same principle — WCM only, never on disk)
.mexc-keys
mexc_*.json

# --- Node / pnpm ---
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Build output ---
dist/
build/
out/
.turbo/
.next/
coverage/
*.tsbuildinfo

# --- Python ML pipeline ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# --- ML model artifacts ---
# Allow model files but never the training data dumps
models/*.pkl
data/raw/
data/cache/
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# --- Editor / OS ---
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# --- Local logs ---
logs/
*.log

# --- Local-only planning scratch (never in git) ---
.planning/local/
.planning/scratch/

# --- Phase 1 (01-01-PLAN) additions — preserve above, append below ---
# (Most entries are already covered above; these are the plan-required minimums.)
.env.local
.env.*.local
data/
# Track the data/ directory itself (via .gitkeep) so SQLite can open the path
# on a fresh clone without ENOENT — contents remain ignored.
!data/.gitkeep

